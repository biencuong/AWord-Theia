{
  "private": true,
  "name": "browser-app",
  "version": "3.0.7",
  "dependencies": {
    "@theia/core": "1.73.1",
    "@theia/editor": "1.73.1",
    "@theia/filesystem": "1.73.1",
    "@theia/markers": "1.73.1",
    "@theia/messages": "1.73.1",
    "@theia/monaco": "1.73.1",
    "@theia/navigator": "1.73.1",
    "@theia/plugin-ext": "1.73.1",
    "@theia/plugin-ext-vscode": "1.73.1",
    "@theia/preferences": "1.73.1",
    "@theia/process": "1.73.1",
    "@theia/search-in-workspace": "1.73.1",
    "@theia/terminal": "1.73.1",
    "@theia/workspace": "1.73.1",
    "aword-chat": "0.0.0"
  },
  "devDependencies": {
    "@theia/cli": "1.73.1"
  },
  "scripts": {
    "bundle": "npm run rebuild && theia build --mode development",
    "rebuild": "theia rebuild:browser --cacheRoot ..",
    "start": "theia start --plugins=local-dir:plugins",
    "watch": "npm run rebuild && theia build --watch --mode development"
  },
  "theia": {
    "target": "browser",
    "frontend": {
      "config": {
        "applicationName": "AWord Pro",
        "defaultLocale": "vi",
        "preferences": {
          "workbench.colorTheme": "dark",
          "window.menuBarVisibility": "classic",
          "workbench.statusBar.visible": false,
          "workbench.tree.renderIndentGuides": "onHover",
          "claudeCode.preferredLocation": "sidebar",
          "claudeCode.hideOnboarding": true,
          "claudeCode.initialPermissionMode": "acceptEdits",
          "files.autoSave": "off",
          "workbench.editorAssociations": {
            "*.md": "default"
          },
          "files.exclude": {
            "**/.git": true,
            "**/.svn": true,
            "**/.hg": true,
            "**/CVS": true,
            "**/.DS_Store": true,
            "**/.aword": true,
            "**/.pdf_anh": true
          },
          "files.watcherExclude": {
            "**/.aword/**": true,
            "**/.pdf_anh/**": true,
            "**/~$*": true,
            "**/.git/objects/**": true,
            "**/.git/subtree-cache/**": true,
            "**/node_modules/**": true,
            "**/.venv/**": true,
            "**/__pycache__/**": true,
            "**/dist/**": true,
            "**/out/**": true,
            "**/.cache/**": true,
            "**/AppData/**": true
          },
          "search.exclude": {
            "**/.aword": true,
            "**/.pdf_anh": true,
            "**/node_modules": true,
            "**/.venv": true,
            "**/__pycache__": true,
            "**/dist": true,
            "**/out": true,
            "**/.git": true
          }
        }
      }
    }
  },
  "theiaPluginsDir": "plugins",
  "theiaPlugins": {
    "Anthropic.claude-code": "https://open-vsx.org/api/Anthropic/claude-code/win32-x64/2.1.270/file/Anthropic.claude-code-2.1.270@win32-x64.vsix"
  },
  "optionalDependencies": {
    "@vscode/windows-ca-certs": "^0.3.4"
  }
}
